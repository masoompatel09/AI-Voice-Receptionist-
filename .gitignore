!.env.template

# Secret keys, certificates, and authentication tokens
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.pub
id_rsa*
id_ed25519*
secrets.json
credentials.json
client_secret*.json
service-account*.json
token.json
auth.json

# Tunneling credentials / configs (ngrok, localtunnel, etc.)
ngrok.yml
.ngrok
*.ngrok

